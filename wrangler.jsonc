{
  "name": "blackops2liga",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blackops2liga",
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ]
}